/// 150 healthcare customers.
table Dim_Customer
	lineageTag: ff20d761-6f86-5729-aaf7-96bafe1e7304

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3184373f-476e-572c-9a97-69abc554e435
		summarizeBy: none
		sourceColumn: CustomerKey

	column CustomerName
		dataType: string
		lineageTag: 99ed5a38-ee0e-55b0-a942-fde10cc5e915
		summarizeBy: none
		sourceColumn: CustomerName

	column CustomerType
		dataType: string
		lineageTag: 24819d26-25bd-5369-a015-0aff10019f80
		summarizeBy: none
		sourceColumn: CustomerType

	column City
		dataType: string
		lineageTag: 6ff5514e-3c16-5402-bc4a-e1eed9f6f060
		summarizeBy: none
		sourceColumn: City

	column State
		dataType: string
		lineageTag: 6f76efae-ce15-558a-9c8d-c1d67d7b2714
