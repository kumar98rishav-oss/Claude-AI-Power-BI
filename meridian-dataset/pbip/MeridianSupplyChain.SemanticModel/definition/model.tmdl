model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","Dim_Date","Dim_Product","Dim_Supplier","Dim_Warehouse","Dim_Customer","Dim_Carrier","Fact_Sales","Fact_Purchases","Fact_Inventory","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Date
ref table Dim_Product
ref table Dim_Supplier
ref table Dim_Warehouse
ref table Dim_Customer
ref table Dim_Carrier
ref table Fact_Sales
ref table Fact_Purchases
ref table Fact_Inventory
ref table _Measures

ref role 'West Region'

ref cultureInfo en-US

