	partition Fact_Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_Sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlanksToNull = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"ShipDate", "DeliveryDate"}),
				    Typed = Table.TransformColumnTypes(BlanksToNull, {{"SalesLineKey", Int64.Type}, {"SalesOrderID", Int64.Type}, {"LineNo", Int64.Type}, {"OrderDate", type date}, {"RequestedDeliveryDate", type date}, {"ShipDate", type date}, {"DeliveryDate", type date}, {"CustomerKey", Int64.Type}, {"ProductKey", Int64.Type}, {"WarehouseKey", Int64.Type}, {"CarrierKey", Int64.Type}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"DiscountPct", type number}, {"SalesAmount", type number}, {"CostAmount", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

