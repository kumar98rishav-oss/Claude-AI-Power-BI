/// One row per sales order line. Blank ShipDate/DeliveryDate = not yet shipped/delivered.
table Fact_Sales
	lineageTag: 749f08a3-b64f-5985-bb44-db51f0326cb7

	column SalesLineKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e6e3e392-3c50-5dae-ae3d-d754d57ad12a
		summarizeBy: none
		sourceColumn: SalesLineKey

	column SalesOrderID
		dataType: int64
		formatString: 0
		lineageTag: f1063bc9-56d5-571c-bf5e-2de095ea4dc0
		summarizeBy: none
		sourceColumn: SalesOrderID

	column LineNo
		dataType: int64
		isHidden
